<?xml version="1.0" encoding="UTF-8"?>

<configuration debug="false">
  <statusListener class="org.beangle.bas.logback.core.status.NopStatusListener"/>
  <appender name="CATALINA" class="org.beangle.bas.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO" additivity="false">
    <appender-ref ref="CATALINA" />
  </root>

</configuration>
